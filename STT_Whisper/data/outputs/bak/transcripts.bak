      {
        "segment_id": "video_001_seg_0227",
        "start_sec": 758.07,
        "end_sec": 758.71,
        "text": "為什麼"
      },
      {
        "segment_id": "video_001_seg_0228",
        "start_sec": 765.57,
        "end_sec": 768.21,
        "text": "好總之咧我們抓到那個"
      },
      {
        "segment_id": "video_001_seg_0229",
        "start_sec": 768.87,
        "end_sec": 769.31,
        "text": "呃"
      },
      {
        "segment_id": "video_001_seg_0230",
        "start_sec": 770.01,
        "end_sec": 771.87,
        "text": "車牌的位置之後osr嘛"
