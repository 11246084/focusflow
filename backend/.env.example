NODE_ENV=development
PORT=4000
# Local MongoDB example:
# MONGODB_URI=mongodb://127.0.0.1:27017/focusflow
# MongoDB Atlas example:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/focusflow?retryWrites=true&w=majority&appName=focusflow
VIDEO_SEGMENT_COLLECTION=video_segments_text
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=7d
# Phase-1 demo should be reproducible by running `npm run seed`, not by relying on startup side effects.
DEMO_SEED_ENABLED=false
UPLOAD_DIR=uploads
# Shared demo env now prefers `gemini + atlas + gemini`.
# `/health` will report `runtime.qa.readiness=hard_fail` if the selected provider
# is missing required config such as `GEMINI_API_KEY`, `OPENAI_API_KEY`,
# or Atlas index settings. For isolated local smoke you may still switch back to
# `mock + memory`, but the actual runtime should be read from `.env` and `/health`.
QA_QUERY_EMBEDDING_PROVIDER=gemini
QA_ANSWER_PROVIDER=gemini
# Shared Atlas contract for `video_segments_text` uses `text_embedding_index`.
# When `QA_VECTOR_SEARCH_MODE=atlas`, the backend fails fast instead of silently
# falling back to memory if the index or filter contract is not ready.
QA_VECTOR_SEARCH_MODE=atlas
# Atlas vector index name（目前共享環境：text_embedding_index for video_segments_text）
# 若要切回本機 memory smoke，可改成 QA_VECTOR_SEARCH_MODE=memory
QA_ATLAS_VECTOR_INDEX_NAME=text_embedding_index
# Current bridge filter contract for `video_segments_text + videos` course scoping.
QA_ATLAS_FILTER_MODE=bridge_course_or_video
QA_MATCH_LIMIT=3
QA_MOCK_EMBEDDING_DIMENSIONS=32
# QA_TIMING=off  # 關閉 [qa-timing] 診斷 log（預設開啟，NODE_ENV=test 自動靜音）
# Required when `QA_ANSWER_PROVIDER=gemini`. Missing key now fails fast.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
# Required when `QA_QUERY_EMBEDDING_PROVIDER=openai` or `QA_ANSWER_PROVIDER=openai`.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# For backend-only LINE verification you may leave these blank.
# In that case webhook route tests still pass, but webhook results will return
# `replySkipped=true` and no live LINE reply will be sent.
# `/health` will show:
# - `runtime.line.readiness=hard_fail` when `LINE_CHANNEL_SECRET` is missing
# - `runtime.line.readiness=degraded` and `deliveryMode=backend_only` when only
#   `LINE_CHANNEL_ACCESS_TOKEN` is missing
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
PROCESSING_WEBHOOK_SECRET=
VITE_LINE_BOT_URL=
# 老師上傳「本地影片檔」時自動上傳到 YouTube（選用功能，預設關閉）。
# 需要 Google Cloud OAuth 2.0 Client（YouTube Data API v3, scope:
# https://www.googleapis.com/auth/youtube.upload）與該頻道帳號的 refresh token。
# 四項齊備且 YOUTUBE_UPLOAD_ENABLED=true 才會啟用；缺任一項會靜默略過，
# 不影響本地上傳與 STT pipeline。狀態記錄在 videos.youtubeUpload。
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# public | unlisted | private（預設 unlisted）
YOUTUBE_UPLOAD_PRIVACY=unlisted