@startuml
' ============================================
' ooad-phase:   物件設計
' chapter:      6-2
' realizes:     UC-01, UC-02, UC-03, UC-06, UC-09
' source:       backend/src/services/auth.service.js, backend/src/services/course.service.js, backend/src/services/enrollment.service.js, backend/src/services/videoBatch.service.js, backend/src/services/videoProcessing.service.js, backend/src/models（程式碼與 schema）
' verified:     2026-09-19
' status:       draft
' implemented:  yes
' ai-assisted:  yes / OpenAI Codex / 依帳號、課程、修課與影片處理責任產出設計類別圖
' ============================================
!include ../_style.puml

title 帳號課程與影片設計類別圖

left to right direction
hide empty members

package "應用服務" as Services {
  ' source-analysis: 帳號與身分驗證
  class AuthService <<service>> {
    + register(profile) : AuthResult
    + login(credentials) : AuthResult
    + getCurrentUser(userId) : PublicUser
    + updateProfile(input) : PublicUser
    + changePassword(input) : void
  }

  ' technical-new: 由登入安全需求拆出的 process-memory throttle
  class LoginThrottleService <<service>> {
    + assertLoginAllowed(email) : void
    + buildLoginFailureError(email) : AppError
    + recordLoginSuccess(email) : void
  }

  ' source-analysis: 課程管理
  class CourseService <<service>> {
    + createCourse(input) : CourseView
    + listCourses(user) : CourseView[]
    + updateCourse(courseId, input, user) : CourseView
    + deleteCourse(courseId, user) : void
    + markVideoOpened(input) : ProgressView
    + markVideoWatched(input) : ProgressView
  }

  ' source-analysis: 修課關係
  class EnrollmentService <<service>> {
    + listCourseEnrollments(input) : EnrollmentView[]
    + assignStudent(input) : EnrollmentView
    + importStudents(input) : ImportSummary
    + revokeStudent(input) : EnrollmentView
  }

  ' source-analysis: 影片批次
  class VideoBatchService <<service>> {
    + createVideoBatch(input) : VideoBatchView
    + getVideoBatch(batchId, user) : VideoBatchView
    + retryVideoBatchItem(batchId, videoId, user) : VideoBatchView
    + syncBatchStatus(batch) : VideoBatchView
  }

  ' source-analysis: 影片處理生命週期
  class VideoProcessingService <<service>> {
    + startVideoProcessing(videoId) : Video
    + completeVideoProcessing(videoId, metadata) : Video
    + failVideoProcessing(videoId, error) : Video
    + retryVideoProcessing(videoId, user) : Video
  }
}

package "核心領域物件" as Domain {
  ' source-analysis: 使用者
  class User <<domain>> {
    + role : UserRole
    + isActive : Boolean
    + lineUserId : String?
    + activeCourseId : Id?
  }

  ' source-analysis: 課程
  class Course <<domain>> {
    + title : String
    + status : CourseStatus
    + teacherId : Id
  }

  ' source-analysis: 修課
  class Enrollment <<domain>> {
    + status : EnrollmentStatus
    + progress : Number
    + watchedVideoIds : Id[]
  }

  ' source-analysis: 教學影片
  class Video <<domain>> {
    + title : String
    + sourceType : VideoSource
    + processing : ProcessingState
  }

  ' source-analysis: 影片批次
  class VideoBatch <<domain>> {
    + status : BatchStatus
    + processingMode : ProcessingMode
    + items : VideoBatchItem[]
  }
}

AuthService ..> LoginThrottleService
AuthService ..> User
CourseService ..> Course
CourseService ..> Enrollment
EnrollmentService ..> Course
EnrollmentService ..> Enrollment
VideoBatchService ..> Course
VideoBatchService ..> Video
VideoBatchService ..> VideoBatch
VideoBatchService ..> VideoProcessingService
VideoProcessingService ..> Video

Course "0..*" --> "1" User : teacher
Enrollment "0..*" --> "1" User : student
Enrollment "0..*" --> "1" Course : course
Course "0..*" --> "0..*" Video : attached videos
Video "0..*" --> "1" User : uploadedBy
VideoBatch "0..*" --> "1" Course : course
VideoBatch "0..*" --> "1" User : createdBy
VideoBatch "0..1" --> "0..10" Video : successful items

note bottom of AuthService
  自助註冊只允許 student；teacher／admin 不開放公開註冊。
end note

note bottom of LoginThrottleService
  技術新增：登入失敗狀態位於單一 process 記憶體，backend 重啟後歸零。
end note

@enduml
