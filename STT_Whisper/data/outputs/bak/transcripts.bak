        "segment_id": "video_001_seg_0535",
        "start_sec": 1663.22,
        "end_sec": 1664.36,
        "text": "他的模型"
      },
      {
        "segment_id": "video_001_seg_0536",
        "start_sec": 1664.48,
        "end_sec": 1665.88,
        "text": "本身也會比較大"
      },
      {
        "segment_id": "video_001_seg_0537",
        "start_sec": 1666.42,
        "end_sec": 1666.86,
        "text": "你"
      },
      {
        "segment_id": "video_001_seg_0538",
        "start_sec": 1667.12,
        "end_sec": 1669.16,
        "text": "哎各位你可以想一想如果我今天"
