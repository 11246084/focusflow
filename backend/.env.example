NODE_ENV=development
PORT=4000
# Comma-separated frontend origins for production CORS, e.g.
# ALLOWED_ORIGINS=https://focusflow.example.com,https://admin.focusflow.example.com
ALLOWED_ORIGINS=
# Local MongoDB example:
# MONGODB_URI=mongodb://127.0.0.1:27017/focusflow
# MongoDB Atlas example:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/focusflow?retryWrites=true&w=majority&appName=focusflow
VIDEO_SEGMENT_COLLECTION=video_segments_text
VIDEO_SEGMENT_VIDEO_COLLECTION=video_segments_video
# Atlas Vector Search index for video_segments_video multimodal retrieval.
# Build/verify with: npm run db:ensure-video-vector-index -- --dry-run
VIDEO_SEGMENTS_VIDEO_VECTOR_INDEX_NAME=video_embedding_index
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=7d
# Phase-1 demo should be reproducible by running `npm run seed`, not by relying on startup side effects.
DEMO_SEED_ENABLED=false
UPLOAD_DIR=uploads
# Dedicated private avatar storage. It must be outside the public UPLOAD_DIR tree.
AVATAR_UPLOAD_DIR=private-data/avatars
# Shared demo env now prefers `gemini + atlas + gemini`.
# `/health` will report `runtime.qa.readiness=hard_fail` if the selected provider
# is missing required config such as `GEMINI_API_KEY`, `OPENAI_API_KEY`,
# or Atlas index settings. For isolated local smoke you may still switch back to
# `mock + memory`, but the actual runtime should be read from `.env` and `/health`.
QA_QUERY_EMBEDDING_PROVIDER=gemini
QA_ANSWER_PROVIDER=gemini
# Shared Atlas contract for `video_segments_text` uses `text_embedding_index`.
# When `QA_VECTOR_SEARCH_MODE=atlas`, the backend fails fast instead of silently
# falling back to memory if the index or filter contract is not ready.
QA_VECTOR_SEARCH_MODE=atlas
# Atlas vector index name（目前共享環境：text_embedding_index for video_segments_text）
# 若要切回本機 memory smoke，可改成 QA_VECTOR_SEARCH_MODE=memory
QA_ATLAS_VECTOR_INDEX_NAME=text_embedding_index
# Current bridge filter contract for `video_segments_text + videos` course scoping.
QA_ATLAS_FILTER_MODE=bridge_course_or_video
# 送進 answer prompt 的片段數上限。2026-07-25 由 3 調為 15：3 時整門課只有約 166 字進
# prompt，跨片段歸納型問題會一律回「目前資料庫片段不足以回答這個問題。」。
QA_MATCH_LIMIT=15
# Phase 2-2 Parent storage（collection 與 Atlas Vector Index 名稱；用 npm run db:ensure-parent-storage 建立）
VIDEO_SEGMENT_PARENT_COLLECTION=video_segments_parent
VIDEO_SEGMENTS_PARENT_VECTOR_INDEX_NAME=parent_embedding_index
# Phase 2-2 kill switch. Adapter 已接妥，但 uploader 與 live E2E 完成前維持 false。
HIERARCHICAL_RETRIEVAL_ENABLED=false
HIERARCHICAL_RETRIEVAL_FALLBACK_TO_LEAF=true
HIERARCHICAL_PARENT_LIMIT=5
HIERARCHICAL_CHILD_EXPANSION_LIMIT=30
HIERARCHICAL_CONTEXT_MAX_LEAVES=15
HIERARCHICAL_CONTEXT_MAX_CHARACTERS=5000
HIERARCHICAL_PARENT_TIMEOUT_MS=1000
QA_MOCK_EMBEDDING_DIMENSIONS=32
QA_ESTIMATED_TOKENS_PER_ASK=1000
QA_MONTHLY_TOKEN_BUDGET=0
QA_USER_MONTHLY_TOKEN_QUOTA=0
# FAQ 快取（常見問題資料庫）：重複問題直接回快取答案，省 embedding / 向量搜尋 / LLM token。
# 第一層：正規化文字完全相同（零 token）；第二層：query embedding cosine 相似度 >= 門檻
# （門檻設 0 或 >1 可停用語意層）。只快取 runtime ready 且不帶對話歷史的回答；
# 影片刪除 / 重新處理完成會自動清該課程快取，教師也可 DELETE /courses/:id/faqs 手動清。
FAQ_CACHE_ENABLED=true
FAQ_CACHE_SIMILARITY_THRESHOLD=0.95
FAQ_CACHE_MAX_ENTRIES_PER_COURSE=200
# QA_TIMING=off  # 關閉 [qa-timing] 診斷 log（預設開啟，NODE_ENV=test 自動靜音）
# Required when `QA_ANSWER_PROVIDER=gemini`. Missing key now fails fast.
GEMINI_API_KEY=
# Stable Gemini Embedding 2 query contract. Preview model names are rejected.
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-2
# Dimension, instruction, generation, normalization and contract versions are
# fixed by the Backend/Pipeline contract; do not override them independently.
# Optional JSON assertions supplied by Pipeline/Database after active vectors are verified.
# Keep blank until the active Leaf/Parent records actually match the contract above.
QA_ACTIVE_LEAF_EMBEDDING_CONTRACT_JSON=
QA_ACTIVE_PARENT_EMBEDDING_CONTRACT_JSON=
GEMINI_CHAT_MODEL=gemini-3.5-flash
# Required when `QA_QUERY_EMBEDDING_PROVIDER=openai` or `QA_ANSWER_PROVIDER=openai`.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
# For backend-only LINE verification you may leave these blank.
# In that case webhook route tests still pass, but webhook results will return
# `replySkipped=true` and no live LINE reply will be sent.
# `/health` will show:
# - `runtime.line.readiness=hard_fail` when `LINE_CHANNEL_SECRET` is missing
# - `runtime.line.readiness=degraded` and `deliveryMode=backend_only` when only
#   `LINE_CHANNEL_ACCESS_TOKEN` is missing
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
PROCESSING_WEBHOOK_SECRET=
VITE_LINE_BOT_URL=
# 老師上傳「本地影片檔」時自動上傳到 YouTube（選用功能，預設關閉）。
# 需要 Google Cloud OAuth 2.0 Client（YouTube Data API v3, scope:
# https://www.googleapis.com/auth/youtube.upload）與該頻道帳號的 refresh token。
# 四項齊備且 YOUTUBE_UPLOAD_ENABLED=true 才會啟用；缺任一項會靜默略過，
# 不影響本地上傳與 STT pipeline。狀態記錄在 videos.youtubeUpload。
YOUTUBE_API_KEY=
# Student Shorts feed metadata sync. Uses YOUTUBE_API_KEY with videos.list only.
# Default: 600000 ms (10 minutes). Set to 0 to disable both startup and interval sync.
SHORTS_SYNC_INTERVAL_MS=600000
YOUTUBE_UPLOAD_ENABLED=false
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Optional short-lived override for local smoke tests; prefer refresh-token flow in shared envs.
YOUTUBE_UPLOAD_ACCESS_TOKEN=
# public | unlisted | private（預設 unlisted）
YOUTUBE_UPLOAD_PRIVACY=unlisted
# 刪除影片 / 課程時，把 FocusFlow 自己上傳的 YouTube 影片轉為 private（不刪除，可還原）。
# 預設開啟，但需要 `youtube.force-ssl` scope 的 refresh token 才會實際生效；
# 只帶 youtube.upload scope 會被 YouTube 以 403 拒絕，刪除流程仍會正常完成。
# 教師貼 YouTube URL 建立的影片位於他人頻道，一律不會被更動。
YOUTUBE_PRIVATIZE_ON_DELETE=true
# YouTube category 27 = Education.
YOUTUBE_UPLOAD_CATEGORY_ID=27
# Legacy aliases YOUTUBE_AUTO_UPLOAD_ENABLED / YOUTUBE_OAUTH_* /
# YOUTUBE_UPLOAD_PRIVACY_STATUS remain supported for existing local environments.
