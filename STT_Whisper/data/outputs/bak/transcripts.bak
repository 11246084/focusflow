        "segment_id": "video_001_seg_0463",
        "start_sec": 1418.9,
        "end_sec": 1419.8,
        "text": "啊走狗"
      },
      {
        "segment_id": "video_001_seg_0464",
        "start_sec": 1420.34,
        "end_sec": 1421.0,
        "text": "第二個"
      },
      {
        "segment_id": "video_001_seg_0465",
        "start_sec": 1421.34,
        "end_sec": 1422.1,
        "text": "走貓"
      },
      {
        "segment_id": "video_001_seg_0466",
        "start_sec": 1424.23,
        "end_sec": 1425.63,
        "text": "啊第三個找車"
      },
      {
        "segment_id": "video_001_seg_0467",
        "start_sec": 1429.34,
        "end_sec": 1430.24,
        "text": "啊所以"
      },
      {
        "segment_id": "video_001_seg_0468",
        "start_sec": 1431.64,
        "end_sec": 1433.64,
        "text": "我會分別"
