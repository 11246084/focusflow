      {
        "segment_id": "video_001_seg_0149",
        "start_sec": 552.92,
        "end_sec": 555.16,
        "text": "呃這兩個其實不太一樣啊"
      },
      {
        "segment_id": "video_001_seg_0150",
        "start_sec": 555.16,
        "end_sec": 556.46,
        "text": "物件偵測是公"
      },
      {
        "segment_id": "video_001_seg_0151",
        "start_sec": 556.72,
        "end_sec": 558.72,
        "text": "是這樣哦就是一張圖"
      },
      {
        "segment_id": "video_001_seg_0152",
        "start_sec": 559.02,
        "end_sec": 560.46,
        "text": "哦這裡是一張圖"
      },
      {
        "segment_id": "video_001_seg_0153",
        "start_sec": 561.22,
        "end_sec": 564.66,
        "text": "物件偵測是我告訴你哪裡有東西"
      },
      {
        "segment_id": "video_001_seg_0154",
        "start_sec": 564.66,
        "end_sec": 566.72,
        "text": "比方說我跟你講哦這邊"
