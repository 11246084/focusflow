classDiagram
    direction LR

    class AuthService {
        <<service>>
        +register() AuthResult
        +login() AuthResult
        +updateProfile() PublicUser
        +changePassword() void
    }
    class LoginThrottle {
        <<service>>
        -attempts : Map~email, FailureEntry~
        +assertLoginAllowed() void
        +buildLoginFailureError() AppError
        +recordLoginSuccess() void
    }
    class CourseAccessService {
        <<service>>
        +canAccessCourse() Boolean
        +assertCanAccessCourse() void
        +assertCanManageCourse() void
        +findActiveEnrollment() Enrollment
    }
    class CourseService {
        <<service>>
        +createCourse() Course
        +updateCourse() Course
        +markVideoOpened() void
        +markVideoWatched() Progress
    }
    class EnrollmentService {
        <<service>>
        +assignStudent() Enrollment
        +importStudents() ImportResult
        +revokeStudent() Enrollment
    }
    class VideoBatchService {
        <<service>>
        +createVideoBatch() VideoBatch
        +getVideoBatch() VideoBatch
        +retryVideoBatchItem() VideoBatch
    }
    class VideoProcessingService {
        <<service>>
        +startVideoProcessing() Video
        +completeVideoProcessing() Video
        +failVideoProcessing() Video
        +retryVideoProcessing() Video
    }

    AuthService ..> LoginThrottle : 登入前檢查鎖定
    CourseService ..> CourseAccessService : 授權
    EnrollmentService ..> CourseAccessService : 授權
    VideoBatchService ..> CourseAccessService : 授權
    VideoProcessingService ..> CourseAccessService : 重試授權
