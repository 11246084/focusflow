[
  {
    "video_id": "video_001",
    "segments": [
      {
        "segment_id": "video_001_seg_0001",
        "start_sec": 4.53,
        "end_sec": 5.33,
        "text": "好"
      },
      {
        "segment_id": "video_001_seg_0002",
        "start_sec": 16.22,
        "end_sec": 21.62,
        "text": "OK 各位 我們今天要開始進入影像的部分"
      },
      {
        "segment_id": "video_001_seg_0003",
        "start_sec": 21.62,
        "end_sec": 25.42,
        "text": "因為AI的應用裡面有幾個大議題"
      },
      {
        "segment_id": "video_001_seg_0004",
        "start_sec": 25.42,
        "end_sec": 27.62,
        "text": "第一個就是數據預測"
      },
      {
        "segment_id": "video_001_seg_0005",
        "start_sec": 27.62,
        "end_sec": 30.62,
        "text": "第二個是自然語言"
      },
      {
        "segment_id": "video_001_seg_0006",
        "start_sec": 30.62,
        "end_sec": 32.62,
        "text": "第三個是影像處理"
      },
      {
        "segment_id": "video_001_seg_0007",
        "start_sec": 32.62,
        "end_sec": 36.42,
        "text": "目前第四個就是生成式AI"
      },
      {
        "segment_id": "video_001_seg_0008",
        "start_sec": 36.42,
        "end_sec": 37.92,
        "text": "生成式AI的話"
      },
      {
        "segment_id": "video_001_seg_0009",
        "start_sec": 37.92,
        "end_sec": 41.42,
        "text": "我們是併著自然語言處理一起講"
      },
      {
        "segment_id": "video_001_seg_0010",
        "start_sec": 41.42,
        "end_sec": 48.02,
        "text": "雖然說生成式AI並不是說只有像CHATGVT這個樣子的"
      },
      {
        "segment_id": "video_001_seg_0011",
        "start_sec": 48.02,
        "end_sec": 49.72,
        "text": "它還有其他的"
      },
      {
        "segment_id": "video_001_seg_0012",
        "start_sec": 49.72,
        "end_sec": 54.82,
        "text": "但是目前絕大部分講到生成式AI的話"
      },
      {
        "segment_id": "video_001_seg_0013",
        "start_sec": 54.82,
        "end_sec": 60.02,
        "text": "都是以CHATGVT這種語言類的生成式AI為主"
      },
      {
        "segment_id": "video_001_seg_0014",
        "start_sec": 60.02,
        "end_sec": 62.52,
        "text": "那其他的生成式AI現在"
      },
      {
        "segment_id": "video_001_seg_0015",
        "start_sec": 62.52,
        "end_sec": 65.92,
        "text": "還有像是圖片的生成式AI"
      },
      {
        "segment_id": "video_001_seg_0016",
        "start_sec": 65.92,
        "end_sec": 68.42,
        "text": "像是什麼Me journey"
      },
      {
        "segment_id": "video_001_seg_0017",
        "start_sec": 68.42,
        "end_sec": 71.02,
        "text": "或是Stable Diffusion"
      },
      {
        "segment_id": "video_001_seg_0018",
        "start_sec": 71.02,
        "end_sec": 77.22,
        "text": "或者是Dali之類的這種應用"
      },
      {
        "segment_id": "video_001_seg_0019",
        "start_sec": 77.22,
        "end_sec": 78.22,
        "text": "其實也有"
      },
      {
        "segment_id": "video_001_seg_0020",
        "start_sec": 78.22,
        "end_sec": 84.62,
        "text": "只是我們總是得選一些做取捨"
      },
      {
        "segment_id": "video_001_seg_0021",
        "start_sec": 84.62,
        "end_sec": 88.12,
        "text": "所以我們就把生成式AI並的自然語言處理"
      },
      {
        "segment_id": "video_001_seg_0022",
        "start_sec": 88.12,
        "end_sec": 89.82,
        "text": "一起跟各位做介紹"
      },
      {
        "segment_id": "video_001_seg_0023",
        "start_sec": 89.82,
        "end_sec": 91.62,
        "text": "然後我們接下來的話"
      },
      {
        "segment_id": "video_001_seg_0024",
        "start_sec": 91.62,
        "end_sec": 94.62,
        "text": "會先跟各位介紹影像處理"
      },
      {
        "segment_id": "video_001_seg_0025",
        "start_sec": 94.62,
        "end_sec": 97.42,
        "text": "那當然後面也會講到數據"
      },
      {
        "segment_id": "video_001_seg_0026",
        "start_sec": 97.42,
        "end_sec": 98.92,
        "text": "數據相關的議題"
      },
      {
        "segment_id": "video_001_seg_0027",
        "start_sec": 98.92,
        "end_sec": 104.02,
        "text": "我們在那個後面做案例的時候"
      },
      {
        "segment_id": "video_001_seg_0028",
        "start_sec": 104.02,
        "end_sec": 106.52,
        "text": "也都會一起帶到了"
      },
      {
        "segment_id": "video_001_seg_0029",
        "start_sec": 106.52,
        "end_sec": 110.02,
        "text": "不過因為那個數據部分的話"
      },
      {
        "segment_id": "video_001_seg_0030",
        "start_sec": 110.02,
        "end_sec": 113.12,
        "text": "處理數據資料前面"
      },
      {
        "segment_id": "video_001_seg_0031",
        "start_sec": 113.12,
        "end_sec": 115.52,
        "text": "各位有上過像是Pendals"
      },
      {
        "segment_id": "video_001_seg_0032",
        "start_sec": 115.52,
        "end_sec": 117.92,
        "text": "或者是Numpire之類的東西"
      },
      {
        "segment_id": "video_001_seg_0033",
        "start_sec": 117.92,
        "end_sec": 120.92,
        "text": "所以我們需要去講的"
      },
      {
        "segment_id": "video_001_seg_0034",
        "start_sec": 120.92,
        "end_sec": 124.42,
        "text": "所謂的前輩知識比較少一點"
      },
      {
        "segment_id": "video_001_seg_0035",
        "start_sec": 124.42,
        "end_sec": 127.32,
        "text": "那所以我們就直接做專案的時候"
      },
      {
        "segment_id": "video_001_seg_0036",
        "start_sec": 127.32,
        "end_sec": 129.32,
        "text": "再跟各位做介紹就可以了"
      },
      {
        "segment_id": "video_001_seg_0037",
        "start_sec": 129.32,
        "end_sec": 135.52,
        "text": "那現在我們主要要先跟各位介紹一下影像"
      },
      {
        "segment_id": "video_001_seg_0038",
        "start_sec": 135.52,
        "end_sec": 140.32,
        "text": "但是影像類的處理的時候"
      },
      {
        "segment_id": "video_001_seg_0039",
        "start_sec": 140.32,
        "end_sec": 142.52,
        "text": "有一個狀況"
      },
      {
        "segment_id": "video_001_seg_0040",
        "start_sec": 142.52,
        "end_sec": 146.82,
        "text": "就是我們會換一個實作的工具"
      },
      {
        "segment_id": "video_001_seg_0041",
        "start_sec": 146.82,
        "end_sec": 149.32,
        "text": "我們會帶各位使用另外一種工具"
      },
      {
        "segment_id": "video_001_seg_0042",
        "start_sec": 149.32,
        "end_sec": 150.82,
        "text": "叫Spider"
      },
      {
        "segment_id": "video_001_seg_0043",
        "start_sec": 150.82,
        "end_sec": 152.82,
        "text": "為什麼要用那個我們後面"
      },
      {
        "segment_id": "video_001_seg_0044",
        "start_sec": 152.82,
        "end_sec": 156.22,
        "text": "等一下開始介紹的時候再說"
      },
      {
        "segment_id": "video_001_seg_0045",
        "start_sec": 157.02,
        "end_sec": 160.62,
        "text": "來我們先跟各位介紹說"
      },
      {
        "segment_id": "video_001_seg_0046",
        "start_sec": 160.62,
        "end_sec": 162.52,
        "text": "我們今天會講什麼"
      },
      {
        "segment_id": "video_001_seg_0047",
        "start_sec": 162.52,
        "end_sec": 167.72,
        "text": "我們今天主要會帶大家了解的是一個工具"
      },
      {
        "segment_id": "video_001_seg_0048",
        "start_sec": 167.72,
        "end_sec": 170.12,
        "text": "它叫OpenCV"
      },
      {
        "segment_id": "video_001_seg_0049",
        "start_sec": 170.12,
        "end_sec": 173.12,
        "text": "那這個工具10-89"
      },
      {
        "segment_id": "video_001_seg_0050",
        "start_sec": 173.12,
        "end_sec": 177.42,
        "text": "做影像處理的人都會接觸到它"
      },
      {
        "segment_id": "video_001_seg_0051",
        "start_sec": 177.42,
        "end_sec": 180.12,
        "text": "那為什麼都會接觸到它呢"
      },
      {
        "segment_id": "video_001_seg_0052",
        "start_sec": 180.12,
        "end_sec": 183.52,
        "text": "因為首先第一個"
      },
      {
        "segment_id": "video_001_seg_0053",
        "start_sec": 183.62,
        "end_sec": 186.32,
        "text": "它是很多人在用的一套"
      },
      {
        "segment_id": "video_001_seg_0054",
        "start_sec": 186.32,
        "end_sec": 189.52,
        "text": "所謂的電腦視覺的一個韓式庫"
      },
      {
        "segment_id": "video_001_seg_0055",
        "start_sec": 189.52,
        "end_sec": 194.82,
        "text": "而且它的牽頭公司其實就是Intel"
      },
      {
        "segment_id": "video_001_seg_0056",
        "start_sec": 194.82,
        "end_sec": 197.32,
        "text": "那本身它又是OpenSource"
      },
      {
        "segment_id": "video_001_seg_0057",
        "start_sec": 197.32,
        "end_sec": 202.62,
        "text": "所以大家都可以去使用"
      },
      {
        "segment_id": "video_001_seg_0058",
        "start_sec": 202.62,
        "end_sec": 206.82,
        "text": "那而且這個OpenCV它有很多個版本"
      },
      {
        "segment_id": "video_001_seg_0059",
        "start_sec": 206.82,
        "end_sec": 211.82,
        "text": "就是它在各個流行的程式語言上面"
      },
      {
        "segment_id": "video_001_seg_0060",
        "start_sec": 211.92,
        "end_sec": 213.92,
        "text": "其實都可以運行"
      },
      {
        "segment_id": "video_001_seg_0061",
        "start_sec": 213.92,
        "end_sec": 219.92,
        "text": "所以這一套工具可以在各個地方來用"
      },
      {
        "segment_id": "video_001_seg_0062",
        "start_sec": 219.92,
        "end_sec": 225.52,
        "text": "而且它支援的檔案格式也很多"
      },
      {
        "segment_id": "video_001_seg_0063",
        "start_sec": 225.52,
        "end_sec": 228.22,
        "text": "而且它也有針對一些"
      },
      {
        "segment_id": "video_001_seg_0064",
        "start_sec": 228.22,
        "end_sec": 231.52,
        "text": "我們在做影像處理的時候常用到的"
      },
      {
        "segment_id": "video_001_seg_0065",
        "start_sec": 231.52,
        "end_sec": 234.52,
        "text": "一些功能它直接都幫你加上去了"
      },
      {
        "segment_id": "video_001_seg_0066",
        "start_sec": 234.52,
        "end_sec": 241.22,
        "text": "所以這個OpenCV這套工具是非常實用的"
      },
      {
        "segment_id": "video_001_seg_0067",
        "start_sec": 241.22,
        "end_sec": 244.92,
        "text": "那我們先來定義一下"
      },
      {
        "segment_id": "video_001_seg_0068",
        "start_sec": 244.92,
        "end_sec": 248.62,
        "text": "如果你要做影像處理類的問題的話"
      },
      {
        "segment_id": "video_001_seg_0069",
        "start_sec": 248.62,
        "end_sec": 253.52,
        "text": "大致上會需要進行哪些步驟"
      },
      {
        "segment_id": "video_001_seg_0070",
        "start_sec": 254.72,
        "end_sec": 259.52,
        "text": "大致上來講都是像這張圖上面的這幾個步驟"
      },
      {
        "segment_id": "video_001_seg_0071",
        "start_sec": 259.52,
        "end_sec": 261.82,
        "text": "第一個叫讀取影像"
      },
      {
        "segment_id": "video_001_seg_0072",
        "start_sec": 261.82,
        "end_sec": 263.62,
        "text": "什麼叫讀取影像呢"
      },
      {
        "segment_id": "video_001_seg_0073",
        "start_sec": 263.62,
        "end_sec": 269.22,
        "text": "其實就是把畫面讀取到電腦的記憶體裡面"
      },
      {
        "segment_id": "video_001_seg_0074",
        "start_sec": 269.32,
        "end_sec": 273.42,
        "text": "因為你要把畫面的數據讀到電腦裡面的記憶體"
      },
      {
        "segment_id": "video_001_seg_0075",
        "start_sec": 274.62,
        "end_sec": 277.92,
        "text": "你才能夠對它進行處理"
      },
      {
        "segment_id": "video_001_seg_0076",
        "start_sec": 278.72,
        "end_sec": 281.52,
        "text": "那這邊的話所謂的讀取影像"
      },
      {
        "segment_id": "video_001_seg_0077",
        "start_sec": 281.52,
        "end_sec": 283.62,
        "text": "通常它會有兩種來源"
      },
      {
        "segment_id": "video_001_seg_0078",
        "start_sec": 283.62,
        "end_sec": 285.72,
        "text": "第一種來源呢"
      },
      {
        "segment_id": "video_001_seg_0079",
        "start_sec": 287.62,
        "end_sec": 288.52,
        "text": "我手"
      },
      {
        "segment_id": "video_001_seg_0080",
        "start_sec": 290.32,
        "end_sec": 291.62,
        "text": "我怎麼寫不出來"
      },
      {
        "segment_id": "video_001_seg_0081",
        "start_sec": 297.78,
        "end_sec": 298.98,
        "text": "我的筆"
      },
      {
        "segment_id": "video_001_seg_0082",
        "start_sec": 302.49,
        "end_sec": 304.09,
        "text": "等一下稍等我一下"
      },
      {
        "segment_id": "video_001_seg_0083",
        "start_sec": 305.59,
        "end_sec": 306.69,
        "text": "我的筆"
      },
      {
        "segment_id": "video_001_seg_0084",
        "start_sec": 309.76,
        "end_sec": 310.16,
        "text": "好"
      },
      {
        "segment_id": "video_001_seg_0085",
        "start_sec": 311.86,
        "end_sec": 313.36,
        "text": "重設一次"
      },
      {
        "segment_id": "video_001_seg_0086",
        "start_sec": 316.74,
        "end_sec": 317.94,
        "text": "這樣可不可以"
      },
      {
        "segment_id": "video_001_seg_0087",
        "start_sec": 342.18,
        "end_sec": 343.38,
        "text": "幫我幫你挑掉"
      },
      {
        "segment_id": "video_001_seg_0088",
        "start_sec": 360.65,
        "end_sec": 361.35,
        "text": "可以了"
      },
      {
        "segment_id": "video_001_seg_0089",
        "start_sec": 371.99,
        "end_sec": 372.39,
        "text": "好"
      },
      {
        "segment_id": "video_001_seg_0090",
        "start_sec": 372.49,
        "end_sec": 374.89,
        "text": "通常我們所謂的讀取影像"
      },
      {
        "segment_id": "video_001_seg_0091",
        "start_sec": 374.89,
        "end_sec": 376.69,
        "text": "它都會有兩種"
      },
      {
        "segment_id": "video_001_seg_0092",
        "start_sec": 377.09,
        "end_sec": 380.09,
        "text": "兩種做輸入的方式"
      },
      {
        "segment_id": "video_001_seg_0093",
        "start_sec": 380.29,
        "end_sec": 383.79,
        "text": "第一種是做從所謂的檔案"
      },
      {
        "segment_id": "video_001_seg_0094",
        "start_sec": 388.36,
        "end_sec": 391.96,
        "text": "也就是File固定的檔案"
      },
      {
        "segment_id": "video_001_seg_0095",
        "start_sec": 392.16,
        "end_sec": 394.36,
        "text": "另外一種呢是那個"
      },
      {
        "segment_id": "video_001_seg_0096",
        "start_sec": 396.16,
        "end_sec": 400.56,
        "text": "比較動態的東西像是攝影機"
      },
      {
        "segment_id": "video_001_seg_0097",
        "start_sec": 407.94,
        "end_sec": 409.64,
        "text": "那個攝影機"
      },
      {
        "segment_id": "video_001_seg_0098",
        "start_sec": 410.04,
        "end_sec": 412.44,
        "text": "那主要呢"
      },
      {
        "segment_id": "video_001_seg_0099",
        "start_sec": 412.94,
        "end_sec": 418.64,
        "text": "我們會從這兩種不同的方式去存取資料"
      },
      {
        "segment_id": "video_001_seg_0100",
        "start_sec": 418.94,
        "end_sec": 421.94,
        "text": "但存取資料的時候有一個比較麻煩的地方"
      },
      {
        "segment_id": "video_001_seg_0101",
        "start_sec": 421.94,
        "end_sec": 423.94,
        "text": "就是攝影機這件東西"
      },
      {
        "segment_id": "video_001_seg_0102",
        "start_sec": 424.14,
        "end_sec": 425.14,
        "text": "因為攝影機"
      },
      {
        "segment_id": "video_001_seg_0103",
        "start_sec": 425.84,
        "end_sec": 431.04,
        "text": "我們會帶各位使用攝影機來直接把那個"
      },
      {
        "segment_id": "video_001_seg_0104",
        "start_sec": 431.74,
        "end_sec": 434.24,
        "text": "拍到的畫面接到電腦裡面去"
      },
      {
        "segment_id": "video_001_seg_0105",
        "start_sec": 434.44,
        "end_sec": 437.24,
        "text": "那這牽扯到一個很現實的問題"
      },
      {
        "segment_id": "video_001_seg_0106",
        "start_sec": 437.54,
        "end_sec": 441.24,
        "text": "就是硬體設備是接在大家的電腦上"
      },
      {
        "segment_id": "video_001_seg_0107",
        "start_sec": 441.24,
        "end_sec": 444.54,
        "text": "而不是接在那個call app的機房對不對"
      },
      {
        "segment_id": "video_001_seg_0108",
        "start_sec": 444.94,
        "end_sec": 445.34,
        "text": "好"
      },
      {
        "segment_id": "video_001_seg_0109",
        "start_sec": 445.44,
        "end_sec": 445.84,
        "text": "那"
      },
      {
        "segment_id": "video_001_seg_0110",
        "start_sec": 446.84,
        "end_sec": 450.74,
        "text": "如果你要用那個call app的話要"
      },
      {
        "segment_id": "video_001_seg_0111",
        "start_sec": 451.54,
        "end_sec": 454.68,
        "text": "基本上你要取得電腦裡面的"
      },
      {
        "segment_id": "video_001_seg_0112",
        "start_sec": 454.68,
        "end_sec": 456.98,
        "text": "攝影機的話是很困難的啦"
      },
      {
        "segment_id": "video_001_seg_0113",
        "start_sec": 456.98,
        "end_sec": 458.38,
        "text": "是可以做到啦"
      },
      {
        "segment_id": "video_001_seg_0114",
        "start_sec": 458.58,
        "end_sec": 461.38,
        "text": "但是他要配搭對像是javascript"
