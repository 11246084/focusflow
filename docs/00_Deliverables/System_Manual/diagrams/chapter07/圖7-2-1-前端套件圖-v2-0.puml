title 前端套件圖
left to right direction

package "bootstrap" as Boot {
  [main.jsx]
}
package "application shells" as Shells {
  [App.jsx]
  [AdminApp.jsx]
  [DashboardApp.jsx]
}
package "pages" as Pages {
  [Student pages]
  [Teacher pages]
  [Admin pages]
  [Profile]
}
package "shared components" as Components {
  [Topbar]
  [Sidebar]
  [IssueReportLauncher]
}
package "services" as Services {
  [api.js]
  [videoUpload.js]
}
package "session and utilities" as Utils {
  [authSession.js]
  [navigationConfig.js]
  [errorMessages.js]
}

Boot ..> Shells : URL entry
Shells ..> Pages : compose by role
Shells ..> Utils : restore / authorize
Pages ..> Components : reuse UI
Pages ..> Services : call API
Components ..> Services : notifications / profile
Services ..> Utils : normalize errors

