        "segment_id": "video_001_seg_0539",
        "start_sec": 1669.28,
        "end_sec": 1671.68,
        "text": "準備一隻模型專門去看"
      },
      {
        "segment_id": "video_001_seg_0540",
        "start_sec": 1672.08,
        "end_sec": 1673.76,
        "text": "啊什麼東西叫做狗"
