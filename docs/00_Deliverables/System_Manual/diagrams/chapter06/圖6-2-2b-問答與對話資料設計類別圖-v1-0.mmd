classDiagram
    direction LR

    class Conversation {
        -userId : ObjectId
        -courseId : ObjectId
        -title : String
    }
    class Message {
        -conversationId : ObjectId
        -role : user｜assistant
        -content : String
        -status : pending｜completed｜failed
        -replyToMessageId : ObjectId
        -sources : Source[]
    }
    class Question {
        -userId : ObjectId
        -courseId : ObjectId
        -question : String
        -answer : String
        -status : answered｜no_match｜failed
        -source : api｜line
        -matches : MatchSnapshot[]
        -sourceUsageLogId : ObjectId
    }
    class Faq {
        -courseId : ObjectId
        -normalizedQuestion : String
        -answer : String
        -matches : MatchSnapshot[]
        -questionEmbedding : Number[]
        -hitCount : Number
    }
    class UsageLog {
        -userId : ObjectId
        -courseId : ObjectId
        -event : login｜watch｜video_open｜ask｜clip_view
        -metadata : Object
    }
    class VideoSegment {
        -videoId : String
        -chunkId : String
        -startSec : Number
        -endSec : Number
        -text : String
        -embedding : Number[]
    }
    class LineBindToken {
        -token : String
        -userId : ObjectId
        -expiresAt : Date
    }

    Message "0..*" --> "1" Conversation : conversationId
    Question "0..*" --> "0..1" UsageLog : sourceUsageLogId
    Message ..> VideoSegment : sources 快照自
    Question ..> VideoSegment : matches 快照自
    Faq ..> VideoSegment : matches 快照自
