classDiagram
    direction TB

    class Avatar {
        -userId : ObjectId
        -data : Buffer
        -mimeType : image/jpeg｜image/png｜image/webp
        -size : Number
    }
    class Notification {
        -recipientId : ObjectId
        -source : video_completed｜system_maintenance｜short_asset_rejected
        -title : String
        -readAt : Date
        -videoId : ObjectId
        -scriptId : ObjectId
        -dedupeKey : String
    }
    class ShortScript {
        -courseId : ObjectId
        -topicKey : String
        -evidence : Evidence[]
        -versions : ScriptVersion[]
        -status : evidence_ready｜generated｜changes_requested｜approved｜dismissed
        -createdBy : ObjectId
    }
    class ShortAsset {
        -courseId : ObjectId
        -sourceScriptId : ObjectId
        -generationVersion : Number
        -reviewStatus : pending｜approved｜rejected
        -status : draft｜ready｜published｜archived
        -disclosure : Disclosure
        -youtubeVideoId : String
        -youtubeAvailability : pending｜playable｜unavailable｜unknown
        -publishedAt : Date
    }

    ShortAsset "0..*" --> "0..1" ShortScript : sourceScriptId
    ShortScript "0..1" <-- "0..*" Notification : scriptId
