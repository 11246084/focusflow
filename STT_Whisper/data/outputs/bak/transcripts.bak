      {
        "segment_id": "video_001_seg_0244",
        "start_sec": 811.57,
        "end_sec": 813.91,
        "text": "哦就去看看那個呃"
      },
      {
        "segment_id": "video_001_seg_0245",
        "start_sec": 813.91,
        "end_sec": 815.97,
        "text": "員工在工作的時候有沒有"
      },
      {
        "segment_id": "video_001_seg_0246",
        "start_sec": 815.97,
        "end_sec": 818.57,
        "text": "違反公安的一些規定啊"
      },
      {
        "segment_id": "video_001_seg_0247",
        "start_sec": 818.57,
        "end_sec": 819.57,
        "text": "像是那個"
      },
      {
        "segment_id": "video_001_seg_0248",
        "start_sec": 819.97,
        "end_sec": 822.91,
        "text": "呃沒有穿戴護具啊"
      },
      {
        "segment_id": "video_001_seg_0249",
        "start_sec": 823.07,
        "end_sec": 826.51,
        "text": "或者是明明廠房內不能奔跑"
      },
      {
        "segment_id": "video_001_seg_0250",
        "start_sec": 826.51,
        "end_sec": 828.71,
        "text": "然後他卻在裡面跑來跑去啊"
      },
      {
        "segment_id": "video_001_seg_0251",
        "start_sec": 828.91,
        "end_sec": 830.91,
        "text": "啊那如果有的話"
      },
      {
        "segment_id": "video_001_seg_0252",
        "start_sec": 830.91,
        "end_sec": 834.67,
        "text": "哦那他可能就要送那個警告訊息給他的主管"
      },
      {
        "segment_id": "video_001_seg_0253",
        "start_sec": 834.97,
        "end_sec": 836.61,
        "text": "哦或者是那個"
