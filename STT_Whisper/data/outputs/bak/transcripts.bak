        "start_sec": 691.48,
        "end_sec": 693.18,
        "text": "我的車牌原來在這裡"
      },
      {
        "segment_id": "video_001_seg_0205",
        "start_sec": 697.22,
        "end_sec": 698.56,
        "text": "哦在這個地方"
