        "segment_id": "video_001_seg_0485",
        "start_sec": 1477.38,
        "end_sec": 1479.36,
        "text": "啊100x100的"
      },
      {
        "segment_id": "video_001_seg_0486",
        "start_sec": 1479.88,
        "end_sec": 1481.48,
        "text": "圖片來講好了啊"
      },
      {
        "segment_id": "video_001_seg_0487",
        "start_sec": 1481.68,
        "end_sec": 1483.78,
        "text": "那100x100總共就有多少個"
