classDiagram
    direction TB

    class AuthService {
        <<service>>
        +register() AuthResult
        +login() AuthResult
        +updateProfile() PublicUser
        +changePassword() void
    }
    class LoginThrottle {
        <<service>>
        -attempts : Map~email, FailureEntry~
        +assertLoginAllowed() void
        +buildLoginFailureError() AppError
        +recordLoginSuccess() void
    }
    class CourseAccessService {
        <<service>>
        +canAccessCourse() Boolean
        +assertCanAccessCourse() void
        +assertCanManageCourse() void
        +findActiveEnrollment() Enrollment
    }
    class CourseService {
        <<service>>
        +createCourse() Course
        +updateCourse() Course
        +markVideoOpened() void
        +markVideoWatched() Progress
    }
    class EnrollmentService {
        <<service>>
        +assignStudent() Enrollment
        +importStudents() ImportResult
        +revokeStudent() Enrollment
    }
    class VideoBatchService {
        <<service>>
        +createVideoBatch() VideoBatch
        +getVideoBatch() VideoBatch
        +retryVideoBatchItem() VideoBatch
    }
    class VideoProcessingService {
        <<service>>
        +startVideoProcessing() Video
        +completeVideoProcessing() Video
        +failVideoProcessing() Video
        +retryVideoProcessing() Video
    }

    class User {
        -name : String
        -email : String
        -passwordHash : String
        -role : student｜teacher｜admin
        -isActive : Boolean
        -lineUserId : String
        -activeCourseId : ObjectId
    }
    class Course {
        -title : String
        -teacherId : ObjectId
        -videoIds : ObjectId[]
        -status : draft｜published｜archived
    }
    class Enrollment {
        -studentId : ObjectId
        -courseId : ObjectId
        -status : active｜revoked
        -progress : Number
        -watchedVideoIds : String[]
        -revokedAt : Date
    }
    class Video {
        -courseId : ObjectId
        -title : String
        -sourceType : upload｜youtube｜external_url
        -fileHash : String
        -processing : ProcessingState
        -youtubeUpload : YouTubeUploadState
    }
    class VideoBatch {
        -batchId : String
        -courseId : ObjectId
        -status : creating｜processing｜completed｜partial｜failed
        -processingMode : single_adapter｜pipeline_batch
        -items : VideoBatchItem[]
    }

    AuthService ..> LoginThrottle : 登入前檢查鎖定
    AuthService ..> User : 建立／驗證
    CourseService ..> CourseAccessService : 授權
    EnrollmentService ..> CourseAccessService : 授權
    VideoBatchService ..> CourseAccessService : 授權
    VideoProcessingService ..> CourseAccessService : 重試授權
    CourseService ..> Course : 維護
    EnrollmentService ..> Enrollment : 維護
    VideoBatchService ..> VideoBatch : 維護
    VideoBatchService ..> Video : 逐檔建立
    VideoProcessingService ..> Video : 狀態轉換

    Course "0..*" --> "1" User : teacherId
    Enrollment "0..*" --> "1" User : studentId
    Enrollment "0..*" --> "1" Course : courseId
    Video "0..*" --> "1" Course : courseId 主課程
    Course "0..*" --> "0..*" Video : videoIds 掛載
    VideoBatch "0..1" --> "0..10" Video : items.videoId
    User "0..*" --> "0..1" Course : activeCourseId（LINE）
