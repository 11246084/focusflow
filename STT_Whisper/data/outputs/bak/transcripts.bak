      },
      {
        "segment_id": "video_001_seg_0146",
        "start_sec": 545.92,
        "end_sec": 549.06,
        "text": "像是物件偵測以及物件本類"
      },
      {
        "segment_id": "video_001_seg_0147",
        "start_sec": 549.32,
        "end_sec": 551.62,
        "text": "啊什麼叫偵測什麼叫分類啊"
