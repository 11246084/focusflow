        "segment_id": "video_001_seg_0237",
        "start_sec": 791.07,
        "end_sec": 793.07,
        "text": "哦會有不同的邏輯"
      },
      {
        "segment_id": "video_001_seg_0238",
        "start_sec": 793.37,
        "end_sec": 797.01,
        "text": "那像我剛剛舉的例子是那個"
      },
      {
        "segment_id": "video_001_seg_0239",
        "start_sec": 797.31,
        "end_sec": 798.61,
        "text": "那個什麼啊"
      },
      {
        "segment_id": "video_001_seg_0240",
        "start_sec": 800.11,
        "end_sec": 801.67,
        "text": "停車場osr"
      },
      {
        "segment_id": "video_001_seg_0241",
        "start_sec": 801.67,
        "end_sec": 804.77,
        "text": "哦他的邏輯就是開放閘門嘛"
      },
      {
        "segment_id": "video_001_seg_0242",
        "start_sec": 805.21,
        "end_sec": 808.67,
        "text": "那有時候比方說你要做那個工廠裡面"
      },
      {
        "segment_id": "video_001_seg_0243",
        "start_sec": 808.67,
        "end_sec": 811.37,
        "text": "去mentend所謂的公安意外"
