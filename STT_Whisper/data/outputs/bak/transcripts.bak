      {
        "segment_id": "video_001_seg_0548",
        "start_sec": 1690.59,
        "end_sec": 1691.49,
        "text": "也不用哦"
      },
      {
        "segment_id": "video_001_seg_0549",
        "start_sec": 1691.49,
        "end_sec": 1694.39,
        "text": "所以他只要顧好自己的事情就好了"
      },
      {
        "segment_id": "video_001_seg_0550",
        "start_sec": 1694.55,
        "end_sec": 1696.45,
        "text": "那他的模型就比較簡單"
