        "segment_id": "video_001_seg_0477",
        "start_sec": 1458.14,
        "end_sec": 1459.14,
        "text": "好這這個"
      },
      {
        "segment_id": "video_001_seg_0478",
        "start_sec": 1459.74,
        "end_sec": 1461.28,
        "text": "很麻煩對不對第一"
      },
      {
        "segment_id": "video_001_seg_0479",
        "start_sec": 1461.64,
        "end_sec": 1465.12,
        "text": "第一個啊我中間要跑幾次"
      },
      {
        "segment_id": "video_001_seg_0480",
        "start_sec": 1465.98,
        "end_sec": 1467.74,
        "text": "我中間要執行幾次"
      },
      {
        "segment_id": "video_001_seg_0481",
        "start_sec": 1468.24,
        "end_sec": 1469.04,
        "text": "一次"
      },
      {
        "segment_id": "video_001_seg_0482",
        "start_sec": 1469.44,
        "end_sec": 1470.24,
        "text": "兩次"
      },
      {
        "segment_id": "video_001_seg_0483",
        "start_sec": 1470.74,
        "end_sec": 1471.58,
        "text": "三次"
      },
      {
        "segment_id": "video_001_seg_0484",
        "start_sec": 1474.46,
        "end_sec": 1477.12,
        "text": "那假設以這邊他是一個"
