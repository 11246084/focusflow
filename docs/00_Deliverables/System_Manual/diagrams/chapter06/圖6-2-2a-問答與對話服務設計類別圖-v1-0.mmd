classDiagram
    direction TB

    class ConversationService {
        <<service>>
        +createConversation() Conversation
        +sendMessage() SendResult
        +retryMessage() SendResult
    }
    class LineService {
        <<service>>
        +generateBindToken() String
        +unbindLineUser() void
        +processWebhookEvents() EventResult[]
    }
    class AskLimitsService {
        <<service>>
        +assertCanAsk() DailyUsage
        +assertDailyAskAvailable() DailyUsage
    }
    class QaService {
        <<service>>
        +askQuestion() QaResult
        +askQuestionFromApi() QaResult
        +recordFailedAsk() void
    }
    class FaqCacheService {
        <<service>>
        +findFaqByExactQuestion() Faq
        +findFaqBySimilarEmbedding() SemanticHit
        +saveFaqEntry() void
        +clearFaqsForVideoCourses() void
    }
    class CostControlService {
        <<service>>
        +assertQaQuotaAvailable() CostSnapshot
    }
    class AnswerGenerationService {
        <<service>>
        +generateAnswer() AnswerResult
        +isNoAnswerReply() Boolean
    }

    ConversationService ..> AskLimitsService : 字數與每日次數
    ConversationService ..> QaService : 委派提問
    LineService ..> AskLimitsService : 字數與每日次數
    LineService ..> QaService : source=line
    QaService ..> FaqCacheService : 兩層快取
    QaService ..> CostControlService : 月 token 配額
    QaService ..> AnswerGenerationService : 生成回答
