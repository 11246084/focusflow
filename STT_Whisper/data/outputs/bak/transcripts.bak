      {
        "segment_id": "video_001_seg_0490",
        "start_sec": 1488.18,
        "end_sec": 1492.62,
        "text": "啊那你這1萬個數字你要分三次運算"
      },
      {
        "segment_id": "video_001_seg_0491",
        "start_sec": 1495.21,
        "end_sec": 1497.41,
        "text": "啊你要分三次運算"
