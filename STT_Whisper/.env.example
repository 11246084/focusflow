# FocusFlow AI pipeline environment variables
VIDEO_INPUT_DIR=Test_video_file
PROCESSED_AUDIO_DIR=data/processed_audio
OUTPUT_DIR=data/outputs
CACHE_DIR=data/cache
VIDEO_MULTIMODAL_CHUNK_DIR=data/video_multimodal_chunks
TERM_DICTIONARY_PATH=data/term_dictionary.json
NORMALIZED_TRANSCRIPT_OUTPUT_PATH=data/outputs/transcripts_normalized.json
CHUNKS_OUTPUT_PATH=data/outputs/chunks.jsonl
TEXT_EMBEDDINGS_OUTPUT_PATH=data/outputs/embeddings_text_gemini.jsonl
AUDIO_EMBEDDINGS_OUTPUT_PATH=data/outputs/embeddings_audio_gemini.jsonl
VIDEO_EMBEDDINGS_OUTPUT_PATH=data/outputs/embeddings_video_gemini.jsonl

# Optional explicit FFmpeg path. Leave blank to use PATH or imageio-ffmpeg.
FFMPEG_BINARY=

# faster-whisper settings
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
WHISPER_CPU_THREADS=8
STT_TASK=transcribe
STT_INITIAL_PROMPT=
STT_CONDITION_ON_PREVIOUS_TEXT=true
STT_TERMINOLOGY_ENABLED=false
STT_TERMINOLOGY_PATH=data/term_dictionary.json
STT_CORRECTION_AUDIT_ENABLED=true
STT_CORRECTION_AUDIT_OUTPUT_PATH=data/outputs/correction_audit.jsonl

# Chunking settings
CHUNK_MAX_CHARS=220
CHUNK_MAX_SEGMENTS=6
CHUNK_MAX_DURATION_SEC=45
CHUNK_OVERLAP_SEGMENTS=0
HIERARCHY_ENABLED=false
HIERARCHY_PARENT_LEAF_COUNT=3
HIERARCHY_PARENT_OVERLAP_LEAVES=0
PARENT_CHUNKS_OUTPUT_PATH=data/outputs/parent_chunks.jsonl
PARENT_EMBEDDING_ENABLED=false
PARENT_EMBEDDINGS_OUTPUT_PATH=data/outputs/embeddings_parent_gemini.jsonl
FUZZY_THRESHOLD=85

# Gemini embedding settings
ENABLE_GEMINI_EMBEDDING=true
ENABLE_GEMINI_VIDEO_EMBEDDING=true
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-2-preview
GEMINI_EMBEDDING_OUTPUT_DIM=3072
GEMINI_EMBEDDING_BATCH_SIZE=1
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_SLEEP_SEC=20
GEMINI_MAX_CHUNKS_PER_RUN=
VIDEO_CHUNK_DURATION_SEC=120
VIDEO_MAX_FILES_PER_RUN=1

# Batch orchestration (bounded because media processing is resource intensive)
BATCH_MAX_CONCURRENCY=1
BATCH_ITEM_MAX_RETRIES=0

# MongoDB upload channel
MONGODB_URI=
MONGODB_DATABASE_NAME=focusflow
MONGODB_VIDEOS_COLLECTION=videos
MONGODB_TRANSCRIPTS_COLLECTION=transcripts_normalized
MONGODB_CHUNKS_COLLECTION=video_segments_text
MONGODB_TEXT_EMBEDDINGS_COLLECTION=video_segments_text
MONGODB_VIDEO_EMBEDDINGS_COLLECTION=video_segments_video
VIDEO_SEGMENT_PARENT_COLLECTION=video_segments_parent
MONGODB_BULK_BATCH_SIZE=200

# Output behavior
OVERWRITE_EXISTING=false
BACKUP_EXISTING_OUTPUTS=true
CLEANUP_AFTER_UPLOAD=false
CLEANUP_KEEP_CHECKPOINTS=true
LOG_LEVEL=INFO

# 後端連線設定（由後端自動觸發 pipeline 時使用）
# BACKEND_URL：後端伺服器位址，用於回報影片處理狀態
# PROCESSING_WEBHOOK_SECRET：與後端 .env 的 PROCESSING_WEBHOOK_SECRET 填入相同值
BACKEND_URL=http://localhost:4000
PROCESSING_WEBHOOK_SECRET=
