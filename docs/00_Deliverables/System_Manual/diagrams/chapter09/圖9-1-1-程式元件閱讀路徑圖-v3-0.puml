@startuml
' ============================================
' ooad-phase:   實作
' chapter:      9-1
' realizes:     UC-01～UC-09（程式閱讀路徑，非 UML）
' source:       frontend/focus-flow/src/main.jsx、backend/src/app.js、backend/src/routes/index.js、
'               backend/src/routes/internal-video.routes.js、backend/src/services/video.service.js、
'               backend/src/services/videoBatchProcessing.service.js、STT_Whisper/src/main.py、
'               STT_Whisper/src/mongodb_uploader.py（程式碼，dev 5230d7a）
' verified:     2026-09-24
' status:       draft
' implemented:  yes
' ai-assisted:  yes / Claude Code / 依第 9 章表9-1-3～表9-1-12 重繪閱讀路徑
' change:       v3-0 補上 LINE 請求入口與外部服務；Pipeline 狀態改經內部 Webhook 回報，
'               不再畫成直接寫入 models；各層改標新版表號（表9-1-3～表9-1-12）；
'               依賴方向與訊息順序的互指改寫在章節正文，不放在圖內註記
' ============================================
!include ../_style.puml

title 程式元件閱讀路徑圖
top to bottom direction
skinparam rectangleFontSize 13

rectangle "瀏覽器：Frontend SPA\nmain.jsx → App.jsx／AdminApp.jsx\n→ DashboardApp.jsx → pages\n（表9-1-9～表9-1-11）" as FE
rectangle "LINE 平台\nMessaging API Webhook" as LINE

package "Backend（Express）" {
  rectangle "HTTP 入口與中介層\napp.js（表9-1-8）、routes（表9-1-3）\nmiddleware（表9-1-7）\nJWT、角色、LINE 簽章、上傳檢查" as RT
  rectangle "請求協調\ncontrollers（表9-1-4）" as CT
  rectangle "業務規則\nservices（表9-1-5）\n課程授權：courseAccess.service.js" as SV
  rectangle "資料模型\nmodels（表9-1-6）" as MD
}

rectangle "外部服務\nGemini、LINE Messaging API、\nYouTube、SMTP" as EXT
database "MongoDB Atlas" as DB

package "AI Pipeline（Python）" {
  rectangle "入口與執行管理\nmain.py、batch_main.py\n（表9-1-12　P-EN）" as PEN
  rectangle "處理階段\n音訊與語音辨識（P-MS）\n切塊與向量（P-CE、P-HR）" as PST
  rectangle "輸出與發布\nmongodb_uploader.py\n（表9-1-12　P-PB）" as PPB
}

FE --> RT : HTTPS JSON／multipart\n/api/v1
LINE --> RT : Webhook\nX-Line-Signature
RT --> CT : 已驗證的請求
CT --> SV : 解析後的輸入
SV --> MD : 查詢／寫入
MD --> DB : Mongoose
SV --> EXT : API 呼叫
SV --> PEN : 以子程序啟動
PEN --> PST : 逐階段執行／續跑
PST --> PPB : 產物驗證
PPB --> DB : upsert 片段與向量
PEN ..> RT : 內部 Webhook 回報狀態\nX-Processing-Secret

@enduml
