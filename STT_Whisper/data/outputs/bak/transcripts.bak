        "segment_id": "video_001_seg_0493",
        "start_sec": 1499.71,
        "end_sec": 1500.47,
        "text": "找的"
      },
      {
        "segment_id": "video_001_seg_0494",
        "start_sec": 1502.31,
        "end_sec": 1502.81,
        "text": "啊"
      },
      {
        "segment_id": "video_001_seg_0495",
        "start_sec": 1503.39,
        "end_sec": 1504.85,
        "text": "找的東西越多"
      },
      {
        "segment_id": "video_001_seg_0496",
        "start_sec": 1509.96,
        "end_sec": 1511.74,
        "text": "啊找的東西越多"
      },
      {
        "segment_id": "video_001_seg_0497",
        "start_sec": 1512.76,
        "end_sec": 1514.36,
        "text": "你的成本越高"
      },
      {
        "segment_id": "video_001_seg_0498",
        "start_sec": 1516.76,
        "end_sec": 1518.22,
        "text": "啊成本也要up"
      },
      {
        "segment_id": "video_001_seg_0499",
        "start_sec": 1520.02,
        "end_sec": 1520.68,
        "text": "而且"
      },
      {
        "segment_id": "video_001_seg_0500",
        "start_sec": 1522.08,
        "end_sec": 1524.08,
        "text": "你的這個模型啊"
      },
      {
        "segment_id": "video_001_seg_0501",
        "start_sec": 1525.16,
        "end_sec": 1527.86,
        "text": "有有時候你還還得"
