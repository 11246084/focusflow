      {
        "segment_id": "video_001_seg_0531",
        "start_sec": 1649.91,
        "end_sec": 1652.05,
        "text": "啊因為他只要算一次就好吧"
      },
      {
        "segment_id": "video_001_seg_0532",
        "start_sec": 1652.05,
        "end_sec": 1653.77,
        "text": "所以當然是優勞比較快啊"
      },
