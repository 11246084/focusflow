      {
        "segment_id": "video_001_seg_0258",
        "start_sec": 848.91,
        "end_sec": 850.27,
        "text": "明確有關係呢"
      },
      {
        "segment_id": "video_001_seg_0259",
        "start_sec": 850.27,
        "end_sec": 852.91,
        "text": "大概是我在中間畫藍色的這個"
      },
