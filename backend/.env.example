# =============================================================================
# 1. 基本服務與安全性
# =============================================================================

# 執行環境；可填 development、test 或 production，本機開發使用 development。
NODE_ENV=development
# 學生試用模式；只有明確設為 true 才啟用 Atlas 與 YouTube 的啟動期硬性檢查。
STUDENT_PILOT_MODE=false
# Backend 監聽連接埠；Frontend 範例預設會連到 4000。
PORT=4000
# 允許跨網域呼叫 Backend 的前端來源；選填，多個網址請用逗號分隔。
# 範例：https://focusflow.example.com,https://admin.focusflow.example.com
ALLOWED_ORIGINS=

# JWT 簽章密鑰；本機可先使用範例值，共用或正式環境務必換成足夠長的隨機字串。
JWT_SECRET=change-me-in-local-env
# JWT 有效期限；可使用 7d、12h 等時間格式。
JWT_EXPIRES_IN=7d

# 是否允許啟動時建立示範資料；預設 false，建議改用 npm run seed 明確執行。
DEMO_SEED_ENABLED=false
# 教師上傳影片的儲存目錄；相對路徑以 backend 資料夾為基準。
UPLOAD_DIR=uploads
# 私人頭像儲存目錄；必須放在公開的 UPLOAD_DIR 之外。
AVATAR_UPLOAD_DIR=private-data/avatars

# =============================================================================
# 2. MongoDB
# =============================================================================

# 主要 MongoDB Atlas 連線字串；請替換 username、password 與 cluster-url。
# 若密碼包含 @、:、/ 等特殊字元，請先進行 URL 編碼。
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/focusflow?retryWrites=true&w=majority&appName=focusflow

# QA 文字片段 collection 名稱。
VIDEO_SEGMENT_COLLECTION=video_segments_text
# 影片／畫面向量片段 collection 名稱。
VIDEO_SEGMENT_VIDEO_COLLECTION=video_segments_video
# video_segments_video 使用的 Atlas Vector Search index 名稱。
VIDEO_SEGMENTS_VIDEO_VECTOR_INDEX_NAME=video_embedding_index
# 階層式檢索的 Parent 片段 collection 與 Atlas Vector Search index 名稱。
VIDEO_SEGMENT_PARENT_COLLECTION=video_segments_parent
VIDEO_SEGMENTS_PARENT_VECTOR_INDEX_NAME=parent_embedding_index

# =============================================================================
# 3. QA 與 AI
# =============================================================================

# 問題 embedding 來源；可填 gemini、openai 或 mock。共用環境預設使用 gemini。
QA_QUERY_EMBEDDING_PROVIDER=gemini
# 回答來源；可填 gemini、openai 或 template。共用環境預設使用 gemini。
QA_ANSWER_PROVIDER=gemini
# 向量搜尋模式；可填 atlas 或 memory。使用共用資料時應保持 atlas。
QA_VECTOR_SEARCH_MODE=atlas
# video_segments_text 使用的 Atlas Vector Search index 名稱。
QA_ATLAS_VECTOR_INDEX_NAME=text_embedding_index
# 課程與影片範圍的 Atlas 過濾契約；目前共用資料使用此固定值。
QA_ATLAS_FILTER_MODE=bridge_course_or_video
# 每次最多送入回答模型的相關片段數量。
QA_MATCH_LIMIT=15
# Candidate30 + 同影片 one-hop 相鄰 Leaf 補齊；預設 false，僅在明確 rollout 時啟用。
QA_LEAF_ADJACENT_CONTEXT_ENABLED=false
# 多輪對話最多保留的歷史輪數。
MAX_CONVERSATION_TURNS=4

# 階層式 Parent → Child 檢索總開關；尚未完成實際就緒狀態驗證前保持 false。
HIERARCHICAL_RETRIEVAL_ENABLED=false
# Parent 檢索不可用時是否退回 Leaf 檢索。
HIERARCHICAL_RETRIEVAL_FALLBACK_TO_LEAF=true
# 分批啟用模式；可填 off、shadow 或 serve，預設 off。只有確認資料與 index 就緒後才調整。
HIERARCHICAL_RETRIEVAL_ROLLOUT_MODE=off
# 分批啟用名單；需要時填入逗號分隔的 MongoDB ObjectId，off 模式可留空。
HIERARCHICAL_RETRIEVAL_ALLOWED_COURSE_IDS=
HIERARCHICAL_RETRIEVAL_ALLOWED_VIDEO_IDS=
HIERARCHICAL_RETRIEVAL_ALLOWED_USER_IDS=
# Parent 候選數、Child 展開數及最後送入模型的內容上限。
HIERARCHICAL_PARENT_LIMIT=5
HIERARCHICAL_CHILD_EXPANSION_LIMIT=30
HIERARCHICAL_CONTEXT_MAX_LEAVES=15
HIERARCHICAL_CONTEXT_MAX_CHARACTERS=5000
# Parent 檢索逾時毫秒數；逾時後依上方 fallback 設定處理。
HIERARCHICAL_PARENT_TIMEOUT_MS=1000

# mock embedding 的向量維度；只供隔離測試使用。
QA_MOCK_EMBEDDING_DIMENSIONS=32
# 每次提問的預估 token 數，用於額度統計。
QA_ESTIMATED_TOKENS_PER_ASK=1000
# 系統與單一使用者的每月 token 上限；0 表示不啟用該項限制。
QA_MONTHLY_TOKEN_BUDGET=0
QA_USER_MONTHLY_TOKEN_QUOTA=0

# 是否啟用 FAQ 快取；相同或高度相似的問題可直接使用既有答案。
FAQ_CACHE_ENABLED=true
# FAQ 語意相似度門檻；0 到 1 之間數值越高越嚴格，設為 0 或大於 1 可停用語意比對。
FAQ_CACHE_SIMILARITY_THRESHOLD=0.95
# 每門課最多保留的 FAQ 快取筆數。
FAQ_CACHE_MAX_ENTRIES_PER_COURSE=200
# 如需關閉 QA 執行時間診斷紀錄，可取消下一行註解；測試環境會自動靜音。
# QA_TIMING=off

# 使用 Gemini 回答或 embedding 時必填；請填 Google AI Studio／Google Cloud 取得的 API Key。
GEMINI_API_KEY=
# Backend 與 STT 必須使用相同的 Gemini embedding 模型契約。
GEMINI_EMBEDDING_MODEL_NAME=gemini-embedding-2
# 選填的部署契約宣告；只有實際 Leaf／Parent 資料確實符合契約時才填入 JSON。
QA_ACTIVE_LEAF_EMBEDDING_CONTRACT_JSON=
QA_ACTIVE_PARENT_EMBEDDING_CONTRACT_JSON=
# Gemini 回答模型名稱。
GEMINI_CHAT_MODEL=gemini-3.5-flash

# 使用 OpenAI 回答或 embedding 時必填；請填 OpenAI Platform 取得的 API Key。
OPENAI_API_KEY=
# OpenAI embedding 與回答模型名稱；只有切換到 openai 供應來源時才會使用。
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# =============================================================================
# 4. LINE Bot
# =============================================================================

# LINE Webhook 簽章密鑰；啟用正式 webhook 時必填，從 LINE Developers Console 取得。
LINE_CHANNEL_SECRET=
# LINE 回覆訊息權杖；需要實際回覆使用者時必填，從 LINE Developers Console 取得。
# 留空時 Backend 仍可測試 webhook，但不會送出實際 LINE 回覆。
LINE_CHANNEL_ACCESS_TOKEN=

# =============================================================================
# 5. 影片與 STT Pipeline
# =============================================================================

# Backend 與 STT processing webhook 共用的密鑰；兩邊必須填入完全相同的隨機字串。
PROCESSING_WEBHOOK_SECRET=
# 本機同時執行的單支影片 Pipeline 數量；其餘工作會留在佇列中。
VIDEO_PROCESSING_CONCURRENCY=1
# 是否改用 STT 批次請求；Backend 與 STT batch 版本未一起部署前保持 false。
VIDEO_BATCH_PIPELINE_ENABLED=false
# Batch manifest 對帳間隔，單位為毫秒；設為 0 可停用週期輪詢，但啟動時仍會對帳一次。
VIDEO_BATCH_RECONCILE_INTERVAL_MS=60000

# =============================================================================
# 6. Shorts 與 YouTube
# =============================================================================

# YouTube Data API v3 的 API Key；Shorts 中繼資料同步時使用，從 Google Cloud Console 取得。
YOUTUBE_API_KEY=
# Shorts 中繼資料同步間隔，單位為毫秒；600000 為 10 分鐘，設為 0 可停用。
SHORTS_SYNC_INTERVAL_MS=600000

# 是否把教師上傳的本地影片自動上傳至 YouTube；預設關閉。
YOUTUBE_UPLOAD_ENABLED=false
# YouTube OAuth 2.0 憑證；啟用自動上傳時必填，從 Google Cloud Console 取得。
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# 對應 YouTube 頻道帳號的長效 refresh token；需包含 youtube.upload scope。
YOUTUBE_REFRESH_TOKEN=
# 選填的短效 access token，只建議用於本機簡易串接測試；共用環境優先使用 refresh token。
YOUTUBE_UPLOAD_ACCESS_TOKEN=
# 上傳後的可見性；可填 public、unlisted 或 private。
YOUTUBE_UPLOAD_PRIVACY=unlisted
# 刪除 FocusFlow 自行上傳的影片時，是否同步改為 private；需 youtube.force-ssl scope。
# 教師貼入的外部 YouTube 網址不會被更動。
YOUTUBE_PRIVATIZE_ON_DELETE=true
# YouTube 影片分類 ID；27 代表 Education。
YOUTUBE_UPLOAD_CATEGORY_ID=27

# 是否在 Backend 啟動時恢復安全可重試的失敗上傳；預設關閉，避免意外觸發外部服務。
YOUTUBE_UPLOAD_RECOVERY_ENABLED=false
# 上傳重試次數、基礎等待時間、每批處理數量及卡住判定時間。
YOUTUBE_UPLOAD_MAX_ATTEMPTS=3
YOUTUBE_UPLOAD_RETRY_BASE_MS=60000
YOUTUBE_UPLOAD_RECOVERY_BATCH_SIZE=5
YOUTUBE_UPLOAD_STUCK_AFTER_MS=900000
# YouTube 上傳與 STT 都完成後，是否刪除 UPLOAD_DIR 內且未被其他影片共用的來源檔。
YOUTUBE_UPLOAD_CLEANUP_ENABLED=false

# 舊環境仍支援 YOUTUBE_AUTO_UPLOAD_ENABLED、YOUTUBE_OAUTH_* 與
# YOUTUBE_UPLOAD_PRIVACY_STATUS；新設定請使用上方變數名稱。

# =============================================================================
# 7. 開發與驗證工具
# =============================================================================

# Phase 2-2 唯讀 E2E 專用 Atlas URI；必須使用只對 focusflow 資料庫具有 read 權限的獨立帳號。
# 預檢指令不會呼叫 Gemini；完整 E2E 仍需另外確認授權後才執行。
PHASE2_2_READONLY_MONGODB_URI=
