{
  "name": "focusflow-backend",
  "version": "0.1.0",
  "description": "Focus Flow MVP backend service",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --ignore uploads src/server.js",
    "start": "node src/server.js",
    "seed": "node src/scripts/seedDemoUsers.js",
    "seed:reset": "node src/scripts/seedDemoUsers.js --reset",
    "db:ensure-auth-audit": "node src/scripts/ensureAuthAuditLog.js",
    "db:ensure-auth-sessions": "node src/scripts/ensureAuthSessions.js",
    "db:ensure-questions": "node src/scripts/ensureQuestionsCollection.js",
    "db:backfill-questions": "node src/scripts/backfillQuestionsFromUsageLogs.js",
    "db:ensure-video-vector-index": "node src/scripts/ensureVideoVectorIndex.js",
    "db:ensure-parent-storage": "node src/scripts/ensureParentStorage.js",
    "db:repair-legacy-enrollments": "node src/scripts/repairLegacyEnrollments.js",
    "db:import-students": "node src/scripts/importStudents.js",
    "db:import-open-edu-videos": "node src/scripts/importOpenEduVideos.js",
    "db:sync-atlas": "node src/scripts/syncLocalMongoToAtlas.js",
    "db:migrate-avatars": "node src/scripts/migrateAvatarsToMongo.js",
    "db:export-deliverable": "node src/scripts/exportDatabaseDeliverable.js",
    "db:restore-deliverable": "node src/scripts/restoreDatabaseDeliverable.js",
    "smoke:shorts:readonly": "node src/scripts/verifyShortsDeployment.js",
    "preflight:phase2-2:readonly": "node src/scripts/phase2_2_hierarchical_e2e_runner.js --preflight-only",
    "e2e:phase2-2:readonly": "node src/scripts/phase2_2_hierarchical_e2e_runner.js",
    "baseline:student-pilot:readonly": "node src/scripts/phase2_2_hierarchical_e2e_runner.js --mode student-pilot-opencv",
    "diagnose:phase3b:readonly": "node src/scripts/phase2_2_hierarchical_e2e_runner.js --mode student-pilot-opencv --questions-file ../docs/04_Features/Student_Pilot_Backend/evidence/2026-09-01_baseline_questions.json --json",
    "diagnose:q04:readonly": "node src/scripts/phase3a_q04_diagnostic.js",
    "eval:multimodal-retrieval:readonly": "node scripts/evaluateMultimodalRetrieval.js",
    "snapshot:student-pilot": "node src/scripts/printStudentPilotFlagSnapshot.js",
    "report:pilot-usage": "node src/scripts/pilotUsageReport.js",
    "docs:lint": "redocly lint docs/openapi.yaml",
    "youtube:release-waiting": "node src/scripts/releaseWaitingYouTubeUploads.js",
    "test:youtube-q-mongo": "node --test integration/youtube-readiness.mongo.js integration/upload-storage.mongo.js integration/youtube-q-full-lifecycle.mongo.js",
    "test:auth-mongo": "node --test integration/auth.mongo.js",
    "test:youtube-mongo": "node --test integration/youtube-lifecycle.mongo.js integration/youtube-review-fixes.mongo.js integration/youtube-recovery-atomicity.mongo.js integration/youtube-f3-f4.mongo.js integration/youtube-quota.mongo.js",
    "test": "node --test --experimental-test-isolation=none --test-concurrency=1"
  },
  "keywords": [
    "focusflow",
    "express",
    "mongodb"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.1.1",
    "mongoose": "^8.13.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^6.10.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@redocly/cli": "2.54.2",
    "nodemon": "^3.1.0"
  }
}
