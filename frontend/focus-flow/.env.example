# Frontend runtime configuration for local development.
# Copy this file to `.env` when the frontend starts reading Vite env vars.

# Backend REST API base URL.
# Backend default dev port comes from `backend/.env.example` -> PORT=4000.
# Current frontend UI does not read this variable yet, but keep it ready for API integration.
VITE_API_BASE_URL=http://127.0.0.1:4000/api/v1
