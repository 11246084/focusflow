      {
        "segment_id": "video_001_seg_0457",
        "start_sec": 1403.76,
        "end_sec": 1404.56,
        "text": "分別"
      },
      {
        "segment_id": "video_001_seg_0458",
        "start_sec": 1406.3,
        "end_sec": 1409.2,
        "text": "利用三個偵測的機制"
      },
      {
        "segment_id": "video_001_seg_0459",
        "start_sec": 1409.7,
        "end_sec": 1410.4,
        "text": "首先"
      },
      {
        "segment_id": "video_001_seg_0460",
        "start_sec": 1411.64,
        "end_sec": 1413.2,
        "text": "我要訓練一個"
      },
      {
        "segment_id": "video_001_seg_0461",
        "start_sec": 1413.5,
        "end_sec": 1415.9,
        "text": "我要訓練一個偵測器找"
