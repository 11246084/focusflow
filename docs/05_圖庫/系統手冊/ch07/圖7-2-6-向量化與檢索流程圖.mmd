flowchart TB
    subgraph P["建立索引：AI Pipeline（每支影片一次）"]
        direction TB
        V["教師上傳的影片檔"]
        A1["① 音訊抽取<br/>FFmpeg → 16 kHz WAV"]
        A2["② 語音辨識<br/>Faster-Whisper<br/>→ 逐句文字＋起訖秒數"]
        A3["③ 逐字稿正規化<br/>專有名詞詞典比對"]
        A4["④ 切段<br/>合併相鄰句子，<br/>字數、句數或秒數達上限即切"]
        A5["⑤ 片段向量<br/>gemini-embedding-2<br/>→ 3072 維單位向量"]
        A6["⑥ 寫入 video_segments_text<br/>文字、起訖秒數、向量"]
        V --> A1 --> A2 --> A3 --> A4 --> A5 --> A6
    end

    subgraph Q["查詢：後端 API（每次提問）"]
        direction TB
        Q0["學生提問（網頁或 LINE）<br/>FAQ 快取未命中才往下"]
        Q1["⑦ 問題向量<br/>同一模型 → 3072 維單位向量"]
        Q2["⑧ 課程範圍向量搜尋<br/>依餘弦相似度取前 15 筆"]
        Q3["⑨ 回答生成<br/>片段編為 S1～S15 送入 prompt"]
        Q4["⑩ 回答附引用<br/>影片、起訖秒數、跳轉連結"]
        Q0 --> Q1 --> Q2 --> Q3 --> Q4
    end

    IDX[("Atlas text_embedding_index<br/>3072 維、cosine")]
    A6 --> IDX
    Q2 -. "$vectorSearch" .-> IDX
