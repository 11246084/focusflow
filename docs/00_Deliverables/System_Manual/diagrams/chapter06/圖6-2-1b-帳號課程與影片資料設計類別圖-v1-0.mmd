classDiagram
    direction TB

    class User {
        -name : String
        -email : String
        -passwordHash : String
        -role : student｜teacher｜admin
        -isActive : Boolean
        -lineUserId : String
        -activeCourseId : ObjectId
    }
    class Course {
        -title : String
        -teacherId : ObjectId
        -videoIds : ObjectId[]
        -status : draft｜published｜archived
    }
    class Enrollment {
        -studentId : ObjectId
        -courseId : ObjectId
        -status : active｜revoked
        -progress : Number
        -watchedVideoIds : String[]
        -revokedAt : Date
    }
    class Video {
        -courseId : ObjectId
        -title : String
        -sourceType : upload｜youtube｜external_url
        -fileHash : String
        -processing : ProcessingState
        -youtubeUpload : YouTubeUploadState
    }
    class VideoBatch {
        -batchId : String
        -courseId : ObjectId
        -status : creating｜processing｜completed｜partial｜failed
        -processingMode : single_adapter｜pipeline_batch
        -items : VideoBatchItem[]
    }

    VideoBatch "0..1" --> "0..10" Video : items.videoId
    Course --> "0..*" Video : videoIds 掛載（多對多）
    Video "0..*" --> "1" Course : courseId 主課程
    Enrollment "0..*" --> "1" Course : courseId
    Enrollment "0..*" --> "1" User : studentId
    Course "0..*" --> "1" User : teacherId
    User "0..*" --> "0..1" Course : activeCourseId（LINE）
