      {
        "segment_id": "video_001_seg_0231",
        "start_sec": 771.87,
        "end_sec": 774.47,
        "text": "osr完了之後如果那個"
      },
      {
        "segment_id": "video_001_seg_0232",
        "start_sec": 774.47,
        "end_sec": 777.11,
        "text": "呃沒有欠費就放你出去嘛"
      },
      {
        "segment_id": "video_001_seg_0233",
        "start_sec": 777.31,
        "end_sec": 779.51,
        "text": "那如果有欠費的話就把你攔下來嘛"
      },
      {
        "segment_id": "video_001_seg_0234",
        "start_sec": 779.77,
        "end_sec": 783.57,
        "text": "那這就是我們所謂的執行的邏輯啦"
